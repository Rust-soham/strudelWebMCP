    "better-result": "3.0.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.3.0"
}
